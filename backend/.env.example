# PostgreSQL - 与前端共用同一个数据库
# JDBC 格式（注意不是 Prisma 的 postgresql:// 格式）
DATABASE_URL=jdbc:postgresql://localhost:5432/axis
DB_USERNAME=postgres
DB_PASSWORD=password

# AI 配置（OpenAI-compatible）
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini

# Digest 2.0 API key 加密（两者丢失会导致已加密 key 不可恢复）
AXIS_ENCRYPTION_PASSWORD=change-me-32-char-long-password!!
AXIS_ENCRYPTION_SALT=0123456789abcdef

# CORS 允许的前端地址
CORS_ORIGINS=http://localhost:7788,http://localhost:3000

# 文件上传目录
UPLOAD_DIR=./uploads
