# PostgreSQL Database Connection (Spring Boot 后端使用)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="jdbc:postgresql://localhost:5432/axis?currentSchema=axis"

# Spring Boot 后端地址（前端通过 AXIS_API_BASE 调用）
AXIS_API_BASE="http://localhost:8080"

# AI 模型配置（OpenAI-compatible）
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com"
AI_MODEL="gpt-4o-mini"
