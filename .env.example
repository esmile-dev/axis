# Axis 环境变量模板 — 本地开发与 Docker 部署共用此文件
# 复制为 .env 并填写真实值（.env 已被 gitignore，切勿提交真实密钥）

# ---------- 数据库（PostgreSQL）----------
# JDBC 格式（不是 postgresql:// 格式）
DATABASE_URL=jdbc:postgresql://localhost:5432/axis
DB_USERNAME=postgres
DB_PASSWORD=password

# ---------- AI 模型（OpenAI-compatible）----------
# 环境变量作为兜底：当数据库中没有任何 AI 配置档案时生效。
# 推荐做法：启动后去 Settings 页添加并激活具体档案，运行时以 DB 档案为准。
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini

# ---------- AI 配置加密（DB 中 API key 加解密）----------
# 两者丢失会导致已加密 key 不可恢复，生产环境务必更换
AXIS_ENCRYPTION_PASSWORD=change-me-32-char-long-password!!
AXIS_ENCRYPTION_SALT=0123456789abcdef

# ---------- 后端 ----------
# CORS 允许的前端地址
CORS_ORIGINS=http://localhost:7788,http://localhost:3000
# 文件上传目录
UPLOAD_DIR=./uploads

# ---------- 前端 ----------
# 前端调用的后端地址（nuxt.config.ts 有相同默认值，本地可不配）
AXIS_API_BASE=http://localhost:7789
